{
  "name": "flora-aroma-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sync:products": "node scripts/build-products.mjs",
    "sync:kyiv-cards": "python scripts/sync-kyiv-card-copy-and-ruta-photo.py",
    "price:pdf": "python scripts/generate-public-price.py",
    "images:fetch-missing": "node scripts/fetch-missing-plant-images.mjs",
    "images:add-local-review": "node scripts/add-local-review-images.mjs && node scripts/add-manual-image-mappings.mjs && node scripts/add-ruta-commons-image.mjs",
    "build": "node scripts/build-site-order-catalog.mjs && astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify-site.mjs",
    "test:catalog-filters": "node scripts/test-catalog-filters.mjs",
    "test:publication-media": "node scripts/test-publication-media.mjs",
    "test:publications": "node scripts/test-publications.mjs",
    "test:site-order": "node scripts/test-site-order-function.mjs",
    "test:analytics": "node scripts/test-analytics-function.mjs",
    "db:migrate:local": "wrangler d1 migrations apply flora-aroma-site-requests --local",
    "db:migrate:remote": "wrangler d1 migrations apply flora-aroma-site-requests --remote"
  },
  "dependencies": {
    "astro": "^6.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
