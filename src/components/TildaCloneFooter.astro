---
import { siteContacts, socialLinks } from "../config/siteContacts";
import { siteNavigationItems } from "../config/siteNavigation";

const showContacts = Astro.props.showContacts ?? false;
---

<footer class={`tilda-contact-footer${showContacts ? "" : " tilda-contact-footer--compact"}`}>
  <nav class="tilda-footer-nav" aria-label="Навігація в підвалі">
    {siteNavigationItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
  {showContacts && (
    <>
      <div class="tilda-contact-footer__text">
        <a href={siteContacts.phoneHref}>{siteContacts.phoneDisplay}</a><br />
        <a href={siteContacts.emailHref}>{siteContacts.emailDisplay}</a>
      </div>
      {socialLinks.length > 0 && (
        <nav class="tilda-socials" aria-label="Соціальні мережі">
          {socialLinks.map((link) => (
            <a
              class={`tilda-socials__link tilda-socials__link--${link.key}`}
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              title={link.label}
            >
              {link.key === "telegram" ? (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.7 4.4 17.8 19c-.2 1.1-.8 1.4-1.7.9l-4.6-3.4-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.7 8.6-7.8c.4-.3-.1-.5-.6-.2L6.1 13 1.5 11.6c-1-.3-1-1 .2-1.4L19.8 3.2c.8-.3 1.5.2.9 1.2Z"></path>
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 8.5V6.8c0-.8.2-1.3 1.3-1.3h1.8V2.2c-.3 0-1.5-.2-2.9-.2-2.9 0-4.9 1.8-4.9 5v1.5H6v3.7h3.3V22H14v-9.8h3.1l.5-3.7H14Z"></path>
                </svg>
              )}
            </a>
          ))}
        </nav>
      )}
    </>
  )}
</footer>
