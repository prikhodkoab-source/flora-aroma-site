---
import { siteContacts, socialLinks } from "../config/siteContacts";

const showContacts = Astro.props.showContacts ?? false;
---

{showContacts && (
  <footer class="tilda-contact-footer">
    <div class="tilda-contact-footer__text">
      <a href={siteContacts.phoneHref}>{siteContacts.phoneDisplay}</a><br />
      <a href={siteContacts.emailHref}>{siteContacts.emailDisplay}</a>
    </div>
    {socialLinks.length > 0 && (
      <nav class="tilda-socials" aria-label="Соціальні мережі">
        {socialLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            {link.label}
          </a>
        ))}
      </nav>
    )}
  </footer>
)}
