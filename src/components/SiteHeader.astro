---
import { siteNavigationItems, type SiteNavKey } from "../config/siteNavigation";

type Variant = "solid" | "overlay";

type Props = {
  navKey?: SiteNavKey | null;
  variant?: Variant;
  showCart?: boolean;
};

const {
  navKey = null,
  variant = "solid",
  showCart = true
} = Astro.props;
---

<header class:list={["site-header", `site-header--${variant}`]} data-site-header>
  <div class="site-header__inner">
    <button
      class="site-menu-toggle"
      type="button"
      data-site-menu-toggle
      aria-expanded="false"
      aria-controls="site-mobile-menu"
      aria-label="Відкрити меню"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="site-header__logo" href="/" aria-label="Флора і Арома">
      <img
        class="site-header__logo-image site-header__logo-image--light"
        src="/images/tilda-clone/logo-white.png"
        alt=""
        aria-hidden="true"
      />
    </a>

    <nav class="site-header__nav" aria-label="Головна навігація">
      {siteNavigationItems.map((item) => (
        <a href={item.href} aria-current={navKey === item.key ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      {showCart && (
        <button class="site-cart-button" type="button" data-cart-open aria-label="Відкрити кошик">
          <span class="site-cart-button__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path d="M16 7h4v13H4V7h4" fill="none" stroke="currentColor" stroke-width="1.8"></path>
              <path d="M8 9V5a4 4 0 1 1 8 0v4" fill="none" stroke="currentColor" stroke-width="1.8"></path>
            </svg>
          </span>
          <span class="site-cart-button__label">Кошик</span>
          <span class="site-cart-button__count" data-cart-count hidden>0</span>
        </button>
      )}
    </div>
  </div>

  <button class="site-menu-backdrop" type="button" data-site-menu-backdrop hidden tabindex="-1" aria-hidden="true"></button>

  <div class="site-mobile-menu" id="site-mobile-menu" data-site-mobile-menu hidden aria-hidden="true">
    <nav class="site-mobile-menu__nav" aria-label="Мобільна навігація">
      {siteNavigationItems.map((item) => (
        <a href={item.href} aria-current={navKey === item.key ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("[data-site-header]");

  if (header instanceof HTMLElement && header.dataset.menuBound !== "true") {
    header.dataset.menuBound = "true";

    const toggle = header.querySelector("[data-site-menu-toggle]");
    const menu = header.querySelector("[data-site-mobile-menu]");
    const backdrop = header.querySelector("[data-site-menu-backdrop]");

    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement) || !(backdrop instanceof HTMLButtonElement)) {
      throw new Error("Site header menu controls are not available.");
    }

    const closeMenu = () => {
      toggle.setAttribute("aria-expanded", "false");
      menu.hidden = true;
      menu.setAttribute("aria-hidden", "true");
      backdrop.hidden = true;
      backdrop.setAttribute("aria-hidden", "true");
      document.body.classList.remove("site-menu-open");
    };

    const openMenu = () => {
      toggle.setAttribute("aria-expanded", "true");
      menu.hidden = false;
      menu.setAttribute("aria-hidden", "false");
      backdrop.hidden = false;
      backdrop.setAttribute("aria-hidden", "false");
      document.body.classList.add("site-menu-open");
    };

    toggle.addEventListener("click", () => {
      if (menu.hidden) {
        openMenu();
        return;
      }
      closeMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    backdrop.addEventListener("click", closeMenu);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) closeMenu();
    });
  }
</script>
