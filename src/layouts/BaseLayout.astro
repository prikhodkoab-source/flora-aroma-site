---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = "Flora & Aroma: актуальний асортимент рослин у горщиках і касетах."
} = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Flora & Aroma">
        <img src="/images/logo.png" alt="" width="88" height="88" />
        <span>
          <strong>FLORA & AROMA</strong>
          <small>саджанці рослин у касетах і горщиках</small>
        </span>
      </a>
      <nav aria-label="Головна навігація">
        <a href="/catalog/">Каталог</a>
        <a href="tel:+380500272882">+380500272882</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>flora-aroma.com.ua</span>
      <span>+380500272882</span>
    </footer>
  </body>
</html>
