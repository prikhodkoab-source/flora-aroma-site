---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import TildaCloneCart from "../components/TildaCloneCart.astro";
import type { SiteNavKey } from "../config/siteNavigation";

type Props = {
  title: string;
  description?: string;
  image?: string | null;
  showCart?: boolean;
  showHeader?: boolean;
  navKey?: SiteNavKey | null;
  headerVariant?: "solid" | "overlay";
  bodyClass?: string;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
};

const {
  title,
  description = "Контейнерні саджанці декоративних, ароматичних і лікарських рослин. Власне вирощування, консультація перед замовленням, погодження наявності.",
  image = "/images/tilda-clone/hero-greenhouse.jpg",
  showCart = true,
  showHeader = true,
  navKey = null,
  headerVariant = "solid",
  bodyClass,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = image ? new URL(image, Astro.site) : null;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Flora & Aroma" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {ogType === "article" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {ogType === "article" && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class:list={["tilda-clone-body", headerVariant === "overlay" && "tilda-clone-body--overlay-header", bodyClass]}>
    {showHeader && <SiteHeader navKey={navKey} variant={headerVariant} showCart={showCart} />}
    <main>
      <slot />
    </main>
    {showCart && <TildaCloneCart />}
    <script>
      import { initializeAnalytics } from "../lib/analytics";
      initializeAnalytics();
    </script>
    {showCart && <script src="/cart.js" defer></script>}
  </body>
</html>
