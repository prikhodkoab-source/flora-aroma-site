---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImageSources } from "../lib/imageSources";

const sources = getImageSources();
const externalSources = sources.filter((source) => source.source === "Wikimedia Commons");
const localSources = sources.filter((source) => source.source !== "Wikimedia Commons");
---

<BaseLayout
  title="Джерела зображень - Flora & Aroma"
  description="Атрибуція зовнішніх і локальних зображень у каталозі Flora & Aroma."
>
  <section class="page-title">
    <p class="eyebrow">Каталог</p>
    <h1>Джерела зображень</h1>
    <p>Фото з локальної папки Flora та відкритих джерел, використані для попереднього перегляду карток рослин.</p>
  </section>

  <section class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>plant_id</th>
          <th>Назва файлу</th>
          <th>Автор / джерело</th>
          <th>Ліцензія</th>
          <th>Статус</th>
        </tr>
      </thead>
      <tbody>
        {externalSources.map((source) => (
          <tr>
            <td>{source.plant_id}</td>
            <td><a href={source.source_page}>{source.title}</a></td>
            <td>{source.author || source.source}</td>
            <td>
              {source.license_url ? <a href={source.license_url}>{source.license}</a> : source.license}
            </td>
            <td>{source.reviewed_status}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section compact-section">
    <h2>Локальні фото</h2>
    <p class="summary">
      {localSources.length} локальних фото підключено як кандидатні зображення і потребують операторської візуальної перевірки перед публікацією як остаточно затверджених.
    </p>
  </section>
</BaseLayout>
