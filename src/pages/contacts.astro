---
import TildaCloneFooter from "../components/TildaCloneFooter.astro";
import { siteContacts } from "../config/siteContacts";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Контакти | Flora & Aroma"
  description="Контакти Flora & Aroma для уточнення наявності рослин, формату контейнера та умов отримання."
  image={null}
  navKey="contacts"
>
  <section class="site-page">
    <div class="site-page__intro site-page__intro--centered">
      <h1>Контакти</h1>
      <p>Напишіть нам, щоб уточнити наявність рослин, формат контейнера та умови отримання.</p>
      <div class="site-page__actions">
        <a class="site-page__button" href={siteContacts.consultationTelegramUrl} target="_blank" rel="noopener noreferrer">
          Написати в Telegram
        </a>
      </div>
    </div>

    <div class="site-contact-grid">
      <article class="site-contact-card">
        <h2>Телефон</h2>
        <p><a href={siteContacts.phoneHref}>{siteContacts.phoneDisplay}</a></p>
      </article>

      <article class="site-contact-card">
        <h2>Сайт</h2>
        <p><a href="https://flora-aroma.com.ua" target="_blank" rel="noopener noreferrer">flora-aroma.com.ua</a></p>
      </article>
    </div>
  </section>

  <TildaCloneFooter showContacts={true} />
</BaseLayout>
