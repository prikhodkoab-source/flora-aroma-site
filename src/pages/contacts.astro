---
import TildaCloneFooter from "../components/TildaCloneFooter.astro";
import { siteContacts } from "../config/siteContacts";
import BaseLayout from "../layouts/BaseLayout.astro";

const contactSocialLinks = [
  { key: "facebook", label: "Facebook", url: siteContacts.facebookUrl },
  { key: "instagram", label: "Instagram", url: siteContacts.instagramUrl },
  { key: "tiktok", label: "TikTok", url: siteContacts.tiktokUrl }
];
---

<BaseLayout
  title="Контакти | Flora & Aroma"
  description="Контакти Flora & Aroma для уточнення наявності рослин, формату контейнера та умов отримання."
  image={null}
  navKey="contacts"
>
  <section class="site-page">
    <div class="site-page__intro site-page__intro--centered">
      <h1>Контакти</h1>
      <p>Напишіть нам, щоб уточнити наявність рослин, формат контейнера та умови отримання.</p>
      <div class="site-page__actions">
        <a class="site-page__button" href={siteContacts.consultationTelegramUrl} target="_blank" rel="noopener noreferrer">
          Написати в Telegram
        </a>
      </div>
    </div>

    <div class="site-contact-grid">
      <article class="site-contact-card site-contact-card--compact">
        <span class="site-contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M6.6 10.8a15.7 15.7 0 0 0 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1 .3 2 .4 3.1.4.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.5 21.2 2.8 13.5 2.8 4.2 2.8 3.5 3.3 3 4 3h3.5c.7 0 1.2.5 1.2 1.2 0 1.1.1 2.1.4 3.1.1.4 0 .9-.3 1.2l-2.2 2.3Z" fill="currentColor"></path>
          </svg>
        </span>
        <p><a href={siteContacts.phoneHref}>{siteContacts.phoneDisplay}</a></p>
      </article>

      <article class="site-contact-card site-contact-card--compact">
        <span class="site-contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M3.5 6.5A2.5 2.5 0 0 1 6 4h12a2.5 2.5 0 0 1 2.5 2.5v11A2.5 2.5 0 0 1 18 20H6a2.5 2.5 0 0 1-2.5-2.5v-11Zm2.1-.5 6.4 5.1 6.4-5.1H5.6Zm12.9 1.3-5.8 4.6a1.1 1.1 0 0 1-1.4 0L5.5 7.3v10.2c0 .3.2.5.5.5h12c.3 0 .5-.2.5-.5V7.3Z" fill="currentColor"></path>
          </svg>
        </span>
        <p><a href={siteContacts.emailHref}>{siteContacts.emailDisplay}</a></p>
      </article>

      <article class="site-contact-card site-contact-card--wide site-contact-card--socials">
        <p class="site-contact-card__label">Соцмережі</p>
        <div class="site-social-links" aria-label="Соцмережі Flora & Aroma">
          {contactSocialLinks.map((link) =>
            link.url ? (
              <a
                class="site-social-link"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class={`site-social-link__icon site-social-link__icon--${link.key}`} aria-hidden="true">
                  {link.key === "facebook" ? (
                    <svg viewBox="0 0 24 24">
                      <path d="M14 8.5V6.8c0-.8.2-1.3 1.3-1.3h1.8V2.2c-.3 0-1.5-.2-2.9-.2-2.9 0-4.9 1.8-4.9 5v1.5H6v3.7h3.3V22H14v-9.8h3.1l.5-3.7H14Z"></path>
                    </svg>
                  ) : link.key === "instagram" ? (
                    <svg viewBox="0 0 24 24">
                      <path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 1.8A2.7 2.7 0 0 0 4.8 7.5v9a2.7 2.7 0 0 0 2.7 2.7h9a2.7 2.7 0 0 0 2.7-2.7v-9a2.7 2.7 0 0 0-2.7-2.7h-9Zm9.8 1.4a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8A3.2 3.2 0 1 0 12 15.2 3.2 3.2 0 0 0 12 8.8Z"></path>
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24">
                      <path d="M14.8 3c-1.2 0-2.2.9-2.3 2.1V13c0 1.6-1.3 2.8-2.9 2.8S6.7 14.6 6.7 13s1.3-2.8 2.9-2.8c.3 0 .6 0 .9.1V8.1c-.3 0-.6-.1-.9-.1A5 5 0 0 0 4.7 13a5 5 0 0 0 4.9 5 5 5 0 0 0 5-5V8.7c1 .7 2.2 1 3.4 1V7.4c-1.4 0-2.6-.8-3.2-2.1A3.2 3.2 0 0 1 14.8 3Z"></path>
                    </svg>
                  )}
                </span>
                {link.label}
              </a>
            ) : (
              <span class="site-social-link site-social-link--disabled" aria-disabled="true">
                <span class={`site-social-link__icon site-social-link__icon--${link.key}`} aria-hidden="true">
                  {link.key === "facebook" ? (
                    <svg viewBox="0 0 24 24">
                      <path d="M14 8.5V6.8c0-.8.2-1.3 1.3-1.3h1.8V2.2c-.3 0-1.5-.2-2.9-.2-2.9 0-4.9 1.8-4.9 5v1.5H6v3.7h3.3V22H14v-9.8h3.1l.5-3.7H14Z"></path>
                    </svg>
                  ) : link.key === "instagram" ? (
                    <svg viewBox="0 0 24 24">
                      <path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 1.8A2.7 2.7 0 0 0 4.8 7.5v9a2.7 2.7 0 0 0 2.7 2.7h9a2.7 2.7 0 0 0 2.7-2.7v-9a2.7 2.7 0 0 0-2.7-2.7h-9Zm9.8 1.4a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8A3.2 3.2 0 1 0 12 15.2 3.2 3.2 0 0 0 12 8.8Z"></path>
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24">
                      <path d="M14.8 3c-1.2 0-2.2.9-2.3 2.1V13c0 1.6-1.3 2.8-2.9 2.8S6.7 14.6 6.7 13s1.3-2.8 2.9-2.8c.3 0 .6 0 .9.1V8.1c-.3 0-.6-.1-.9-.1A5 5 0 0 0 4.7 13a5 5 0 0 0 4.9 5 5 5 0 0 0 5-5V8.7c1 .7 2.2 1 3.4 1V7.4c-1.4 0-2.6-.8-3.2-2.1A3.2 3.2 0 0 1 14.8 3Z"></path>
                    </svg>
                  )}
                </span>
                {link.label}
              </span>
            )
          )}
        </div>
      </article>
    </div>
  </section>

  <TildaCloneFooter showContacts={true} />
</BaseLayout>
