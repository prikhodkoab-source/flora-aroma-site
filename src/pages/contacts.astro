---
import TildaCloneFooter from "../components/TildaCloneFooter.astro";
import { siteContacts } from "../config/siteContacts";
import BaseLayout from "../layouts/BaseLayout.astro";

const contactSocialLinks = [
  { key: "facebook", label: "Facebook", url: siteContacts.facebookUrl },
  { key: "instagram", label: "Instagram", url: siteContacts.instagramUrl },
  { key: "tiktok", label: "TikTok", url: siteContacts.tiktokUrl }
];
---

<BaseLayout
  title="Контакти | Flora & Aroma"
  description="Контакти Flora & Aroma для уточнення наявності рослин, формату контейнера та умов отримання."
  image={null}
  navKey="contacts"
>
  <section class="site-page">
    <div class="site-page__intro site-page__intro--centered">
      <h1>Контакти</h1>
      <p>Напишіть нам, щоб уточнити наявність рослин, формат контейнера та умови отримання.</p>
      <div class="site-page__actions">
        <a class="site-page__button" href={siteContacts.consultationTelegramUrl} target="_blank" rel="noopener noreferrer">
          Написати в Telegram
        </a>
      </div>
    </div>

    <div class="site-contact-grid">
      <article class="site-contact-card">
        <h2>Телефон</h2>
        <p><a href={siteContacts.phoneHref}>{siteContacts.phoneDisplay}</a></p>
      </article>

      <article class="site-contact-card">
        <h2>Електронна пошта</h2>
        <p><a href={siteContacts.emailHref}>{siteContacts.emailDisplay}</a></p>
      </article>

      <article class="site-contact-card site-contact-card--wide">
        <h2>Соцмережі</h2>
        <div class="site-social-links" aria-label="Соцмережі Flora & Aroma">
          {contactSocialLinks.map((link) =>
            link.url ? (
              <a
                class="site-social-link"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            ) : (
              <span class="site-social-link site-social-link--disabled" aria-disabled="true">
                {link.label}
              </span>
            )
          )}
        </div>
      </article>
    </div>
  </section>

  <TildaCloneFooter showContacts={true} />
</BaseLayout>
