---
import { render } from "astro:content";
import TildaCloneFooter from "../../components/TildaCloneFooter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatProductStartingPrice, getProducts } from "../../lib/products";
import {
  getApprovedPublications,
  getBodyMedia,
  getCoverMedia,
  getDraftPreviewPublication,
  type PublicPublication
} from "../../lib/publications";

export async function getStaticPaths() {
  const publications = await getApprovedPublications();
  const draftPreview = await getDraftPreviewPublication();

  const paths = publications.map((publication) => ({
    params: { slug: publication.data.slug },
    props: { publication, previewMode: false }
  }));
  if (draftPreview) {
    paths.push({ params: { slug: draftPreview.data.slug }, props: { publication: draftPreview, previewMode: true } });
  }
  return paths;
}

type Props = {
  publication: PublicPublication;
  previewMode: boolean;
};

const { publication, previewMode } = Astro.props;
const { data } = publication;
const { Content } = await render(publication);
const coverMedia = getCoverMedia(publication);
const bodyMedia = getBodyMedia(publication);
const productById = new Map(getProducts().map((product) => [product.plant_id, product]));
const plantCardById = new Map(data.relatedPlantCards.map((card) => [card.plantId, card]));
const collectionProducts = data.relatedPlantIds.flatMap((plantId) => {
  const product = productById.get(plantId);
  const card = plantCardById.get(plantId);
  return product ? [{ product, card }] : [];
});
const publishedDate = data.publishedAt ? new Intl.DateTimeFormat("uk-UA", {
  day: "numeric",
  month: "long",
  year: "numeric"
}).format(data.publishedAt) : null;
---

<BaseLayout
  title={data.seoTitle}
  description={data.seoDescription}
  image={data.coverImage ?? null}
  navKey="publications"
  ogType="article"
  articlePublishedTime={data.publishedAt?.toISOString()}
  articleModifiedTime={data.updatedAt?.toISOString()}
  robots={previewMode ? "noindex,nofollow,noarchive" : undefined}
  canonicalPath={previewMode ? null : undefined}
>
  <section class="collection-hero">
    <div class="collection-shell">
      <a class="publication-back" href="/publications/">Поради та ідеї</a>
      <p class="collection-eyebrow">{data.category} · {previewMode ? "Чернетка для перегляду" : publishedDate}</p>
      <h1>{data.title}</h1>
      <p class="collection-lead">{data.subtitle ?? data.excerpt}</p>
    </div>
  </section>

  <section class="collection-content">
    <div class="collection-shell collection-grid">
      <article class="collection-article publication-detail">
        {coverMedia && (
          <figure class="publication-detail__media publication-detail__media--cover">
            <img class="publication-detail__cover" src={coverMedia.src} alt={coverMedia.alt} loading="eager" />
            <figcaption>{coverMedia.caption}</figcaption>
          </figure>
        )}
        <Content />
        {data.bodyMediaLayout !== "inline" && bodyMedia.length > 0 && (
          <div class="publication-detail__gallery">
            {bodyMedia.map((item) => (
              <figure class="publication-detail__media">
                <img src={item.src} alt={item.alt} loading="lazy" />
                <figcaption>{item.caption}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </article>

      {collectionProducts.length > 0 && (
        <section class="collection-plants" aria-label="Рослини з цієї публікації">
          <h2>Рослини з цієї публікації</h2>
          <p>Наявність і формат контейнера підтверджує оператор перед замовленням.</p>
          <div class="collection-plant-list">
            {
              collectionProducts.map(({ product, card }) => (
                  <a
                    class:list={["collection-plant-card", { "collection-plant-card--link-only": !card }]}
                    href={`/plants/${product.slug}/`}
                  >
                    {card && <img src={card.src} alt={card.alt} loading="lazy" />}
                    <span>
                      <strong>{product.name_uk}</strong>
                      <em>{product.latin_name}</em>
                      <small>{formatProductStartingPrice(product)}</small>
                    </span>
                  </a>
                ))
            }
          </div>
        </section>
      )}
    </div>
  </section>

  <section class="collection-cta">
    <div class="collection-shell">
      <h2>Потрібна консультація щодо рослин?</h2>
      <p>Перейдіть до асортименту або напишіть нам, щоб уточнити наявність, формат контейнера та доречні варіанти для вашої ділянки.</p>
      <a href="/shop/">Перейти до асортименту</a>
    </div>
  </section>

  <TildaCloneFooter showContacts={true} />
</BaseLayout>

<style>
  .collection-shell {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .collection-hero {
    padding: 74px 0 72px;
    background: #eef4ea;
  }

  .collection-hero .publication-back {
    margin-bottom: 32px;
  }

  .collection-eyebrow {
    margin: 0 0 18px;
    color: #4d6b45;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .collection-hero h1 {
    max-width: 880px;
    margin: 0;
    color: #1d2819;
    font-size: 58px;
    line-height: 1.08;
  }

  .collection-lead {
    max-width: 740px;
    margin: 28px 0 0;
    color: #3b4536;
    font-size: 22px;
    line-height: 1.55;
  }

  .collection-content {
    padding: 72px 0;
    background: #ffffff;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: minmax(0, 820px);
    justify-content: center;
    gap: 72px;
    align-items: start;
  }

  .collection-article {
    min-width: 0;
  }

  .collection-article .publication-detail__media {
    min-width: 0;
  }

  .collection-article .publication-detail__media img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .collection-article :global(h2) {
    margin: 48px 0 16px;
    color: #1d2819;
    font-size: 32px;
    line-height: 1.2;
  }

  .collection-article :global(h2:first-child) {
    margin-top: 0;
  }

  .collection-article :global(p),
  .collection-article :global(li) {
    color: #2f352c;
    font-size: 19px;
    line-height: 1.68;
  }

  .collection-article :global(p) {
    margin: 0 0 22px;
  }

  .collection-article :global(ul) {
    display: grid;
    gap: 14px;
    margin: 0 0 26px;
    padding-left: 22px;
  }

  .collection-article :global(.publication-inline-media) {
    margin: 30px 0 40px;
  }

  .collection-article :global(.publication-inline-media img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .collection-article :global(.publication-inline-media figcaption) {
    margin-top: 10px;
    color: #596254;
    font-size: 14px;
    line-height: 1.5;
  }

  .collection-plants {
    padding-top: 48px;
    border-top: 1px solid #dbe5d6;
  }

  .collection-plants h2 {
    margin: 0 0 12px;
    color: #1d2819;
    font-size: 28px;
    line-height: 1.2;
  }

  .collection-plants p {
    margin: 0 0 22px;
    color: #4b5547;
    font-size: 16px;
    line-height: 1.55;
  }

  .collection-plant-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .collection-plant-card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 12px;
    align-content: start;
    padding: 10px;
    border: 1px solid #dbe5d6;
    border-radius: 6px;
    background: #ffffff;
    color: #20241d;
    text-decoration: none;
  }

  .collection-plant-card--link-only {
    grid-template-rows: 1fr;
    align-items: center;
    min-height: 160px;
    padding: 24px;
    background: #f7faf4;
  }

  .collection-plant-card--link-only span {
    padding: 0;
  }

  .collection-plant-card img {
    width: 100%;
    aspect-ratio: 941 / 1672;
    object-fit: contain;
    background: #f8f8f4;
  }

  .collection-plant-card span {
    padding: 0 4px 6px;
  }

  .collection-plant-card strong,
  .collection-plant-card em,
  .collection-plant-card small {
    display: block;
  }

  .collection-plant-card strong {
    font-size: 16px;
    line-height: 1.25;
  }

  .collection-plant-card em {
    margin-top: 4px;
    color: #596254;
    font-size: 14px;
    line-height: 1.3;
  }

  .collection-plant-card small {
    margin-top: 6px;
    color: #304a29;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .collection-cta {
    padding: 72px 0;
    background: #263820;
    color: #ffffff;
    text-align: center;
  }

  .collection-cta h2 {
    margin: 0;
    font-size: 40px;
    line-height: 1.2;
  }

  .collection-cta p {
    max-width: 700px;
    margin: 22px auto 30px;
    font-size: 20px;
    line-height: 1.55;
  }

  .collection-cta a {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
    background: #ffffff;
    color: #1d2819;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .collection-hero {
      padding: 58px 0 52px;
    }

    .collection-hero h1 {
      font-size: 38px;
    }

    .collection-lead {
      font-size: 19px;
    }

    .collection-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 42px;
    }

    .collection-plants {
      padding-top: 38px;
    }

    .collection-plant-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .collection-shell {
      width: min(100% - 28px, 1120px);
    }

    .collection-hero h1 {
      font-size: 32px;
    }

    .collection-content,
    .collection-cta {
      padding: 48px 0;
    }

    .collection-article :global(h2) {
      font-size: 26px;
    }

    .collection-article :global(p),
    .collection-article :global(li) {
      font-size: 17px;
    }

    .collection-plant-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .collection-plant-card {
      width: min(100%, 320px);
      justify-self: center;
    }

    .collection-cta h2 {
      font-size: 30px;
    }
  }
</style>
