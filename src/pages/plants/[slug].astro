---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TildaCloneFooter from "../../components/TildaCloneFooter.astro";
import { formatOptionPrice, getOptionDisplayName, getProducts } from "../../lib/products";

export function getStaticPaths() {
  return getProducts().map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const imagePaths = product.image_paths.length > 0 ? product.image_paths : ["/images/tilda-clone/tilda-logo.png"];
const selectedOption = product.options[0] ?? {
  variant_id: "default",
  container_type_id: "",
  format_code: "",
  container: product.container,
  price_uah: product.price_uah,
  unit: product.unit,
  label: ""
};
const selectedOptionDisplayName = getOptionDisplayName(selectedOption);
---

<BaseLayout
  title={product.seo_title || `${product.name_uk} | Flora & Aroma`}
  description={product.seo_description || product.summary}
  image={imagePaths[0]}
  navKey="catalog"
>
  <article
    class="tilda-product-page"
    data-product-page
    data-analytics-plant-id={product.plant_id}
    data-analytics-plant-name={product.name_uk}
  >
    <a class="tilda-back-link" href="/shop/">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M10.7 6.3 5 12l5.7 5.7 1.4-1.4L8.8 13H19v-2H8.8l3.3-3.3-1.4-1.4Z"></path>
      </svg>
      <span>Назад до асортименту</span>
    </a>
    <div class="tilda-product-layout">
      <section class="tilda-product-gallery" data-gallery>
        <button class="tilda-product-gallery__stage" type="button" data-gallery-open aria-label="Переглянути фото">
          <img src={imagePaths[0]} alt={product.name_uk} data-gallery-image />
        </button>
        {imagePaths.length > 1 && (
          <div class="tilda-product-gallery__thumbs">
            {imagePaths.map((path, index) => (
              <button type="button" data-gallery-thumb data-src={path} data-index={index} aria-pressed={index === 0 ? "true" : "false"}>
                <img src={path} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </section>

      <section class="tilda-product-info">
        <h1>{product.name_uk}</h1>
        <p class="tilda-product-latin"><em>{product.latin_name}</em></p>
        <div class="tilda-product-price" data-selected-price>{formatOptionPrice(selectedOption)}</div>
        <p class="tilda-product-summary">{product.summary}</p>
        <div class="tilda-product-options">
          <div class="tilda-input-title">Об'єм</div>
          {product.options.map((option, index) => (
            <label>
              <input
                type="radio"
                name={`option-${product.plant_id}`}
                checked={index === 0}
                data-product-option
                data-option-id={option.variant_id}
                data-container={getOptionDisplayName(option)}
                data-price={option.price_uah}
                data-price-label={formatOptionPrice(option)}
                data-currency="UAH"
                data-unit={option.unit}
              />
              <span>{getOptionDisplayName(option)} — {formatOptionPrice(option)}</span>
            </label>
          ))}
        </div>

        <label class="tilda-quantity">
          <span>Кількість</span>
          <input type="number" min="1" step="1" value="1" data-product-qty />
        </label>

        <button
          class="tilda-buy-button"
          type="button"
          data-cart-add
          data-plant-id={product.plant_id}
          data-name={product.name_uk}
          data-latin={product.latin_name}
          data-container={selectedOptionDisplayName}
          data-price={selectedOption.price_uah}
          data-currency="UAH"
          data-unit={selectedOption.unit}
          data-option-id={selectedOption.variant_id}
          data-url={`/plants/${product.slug}/`}
          data-image={imagePaths[0]}
        >
          Додати до кошика
        </button>
      </section>
    </div>

    <section class="tilda-product-description">
      <h2>Опис</h2>
      <p>{product.full_description || product.summary}</p>
      <dl>
        <div><dt>Освітлення</dt><dd>{product.sun_labels.join(" / ")}</dd></div>
        <div><dt>Волога</dt><dd>{product.moisture_labels.join(" / ")}</dd></div>
        <div><dt>Висота</dt><dd>{product.height_cm_min}-{product.height_cm_max} см</dd></div>
        <div><dt>Цвітіння</dt><dd>{product.flowering_labels.join(", ")}</dd></div>
        <div><dt>Зимостійкість</dt><dd>{product.winter_hardiness_short}</dd></div>
      </dl>
    </section>
  </article>

  <TildaCloneFooter showContacts={true} />
</BaseLayout>

<script>
  document.querySelectorAll("[data-gallery]").forEach((gallery) => {
    const image = gallery.querySelector("[data-gallery-image]");
    const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        if (!(image instanceof HTMLImageElement)) return;
        image.src = thumb.dataset.src || image.src;
        thumbs.forEach((item) => item.setAttribute("aria-pressed", item === thumb ? "true" : "false"));
      });
    });
  });

  document.querySelectorAll("[data-product-page]").forEach((page) => {
    const addButton = page.querySelector("[data-cart-add]");
    const price = page.querySelector("[data-selected-price]");
    page.querySelectorAll("[data-product-option]").forEach((input) => {
      input.addEventListener("change", () => {
        if (!(input instanceof HTMLInputElement) || !input.checked || !(addButton instanceof HTMLElement)) return;
        addButton.dataset.container = input.dataset.container || "";
        addButton.dataset.price = input.dataset.price || "";
        addButton.dataset.unit = input.dataset.unit || "шт.";
        addButton.dataset.optionId = input.dataset.optionId || "";
        if (price) price.textContent = input.dataset.priceLabel || "";
      });
    });
  });
</script>
