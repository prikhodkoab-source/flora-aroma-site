---
import BaseLayout from "../layouts/BaseLayout.astro";
import TildaCloneFooter from "../components/TildaCloneFooter.astro";
---

<BaseLayout title="Кошик | Flora & Aroma" navKey="catalog">
  <section class="tilda-cart-route">
    <h1>Ваше замовлення</h1>
    <p>Кошик відкривається у форматі Tilda. Заявка не створює резерв, оплату або списання складу без підтвердження оператора.</p>
    <button class="tilda-buy-button" type="button" data-cart-open>Відкрити кошик</button>
    <a class="tilda-back-link" href="/shop/">← Повернутися до асортименту</a>
  </section>
  <TildaCloneFooter showContacts={true} />
</BaseLayout>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    document.querySelector("[data-cart-open]")?.click();
  });
</script>
