---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatFlowering,
  formatHeight,
  formatProductOptionSummary,
  formatProductStartingPrice,
  getProducts,
  getPublicAvailabilityLabel,
  getSelections,
  productMatchesSelection
} from "../../lib/products";

export function getStaticPaths() {
  return getSelections().map((selection) => ({
    params: { slug: selection.slug },
    props: { selection }
  }));
}

const { selection } = Astro.props;
const products = getProducts().filter((product) => productMatchesSelection(product, selection));
const description = `${selection.title}: ${products.length} позицій Flora & Aroma. Ціни з публічного прайсу, наявність підтверджує оператор.`;
---

<BaseLayout title={`${selection.title} | Flora & Aroma`} description={description}>
  <section class="page-title">
    <p class="eyebrow">Добірка</p>
    <h1>{selection.title}</h1>
    <p>{selection.description} У добірці {products.length} позицій; фактичну наявність і резерв підтверджує оператор.</p>
  </section>

  <section class="section">
    <div class="product-grid">
      {products.map((product) => (
        <a class="product-card" href={`/plants/${product.slug}/`}>
          {product.primary_image_path && <img src={product.primary_image_path} alt="" loading="lazy" />}
          <span class="plant-id">{product.category}</span>
          <h3>{product.name_uk}</h3>
          <p><em>{product.latin_name}</em></p>
          <p class="summary">{product.summary}</p>
          <div class="card-chips" aria-label="Короткі характеристики">
            <span>сонце: {product.sun_labels.join(" / ")}</span>
            <span>вологість: {product.moisture_labels.join(" / ")}</span>
            <span>висота: {formatHeight(product)}</span>
            <span>цвітіння: {formatFlowering(product)}</span>
            <span>призначення: {product.use_case_labels.slice(0, 2).join(", ")}</span>
            <span>типорозміри: {formatProductOptionSummary(product, 3)}</span>
            <span>ціна: {formatProductStartingPrice(product)}</span>
          </div>
          <dl>
            <div>
              <dt>Типорозміри</dt>
              <dd>{formatProductOptionSummary(product)}</dd>
            </div>
            <div>
              <dt>Ціна</dt>
              <dd>{formatProductStartingPrice(product)}</dd>
            </div>
            <div>
              <dt>Наявність</dt>
              <dd>{getPublicAvailabilityLabel(product)}</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
