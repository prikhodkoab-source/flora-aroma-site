---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Статистика сайту | Flora & Aroma" showCart={false} showHeader={false}>
  <section class="flora-admin-stats" data-admin-statistics>
    <header class="flora-admin-stats__header">
      <p class="flora-admin-stats__eyebrow">Flora & Aroma</p>
      <h1>Статистика сайту</h1>
      <p>Власна privacy-safe аналітика: без контактів клієнтів, текстів заявок, точного складу або live-проводок.</p>
    </header>

    <div class="flora-admin-stats__notice" data-analytics-notice hidden></div>

    <div class="flora-admin-stats__controls" aria-label="Період статистики">
      <button type="button" data-period="today">Сьогодні</button>
      <button type="button" data-period="yesterday">Вчора</button>
      <button type="button" data-period="7d">7 днів</button>
      <button type="button" data-period="30d" class="is-active">30 днів</button>
      <button type="button" data-period="90d">90 днів</button>
      <button type="button" data-period="current_month">Поточний місяць</button>
      <button type="button" data-period="previous_month">Попередній місяць</button>
    </div>

    <form class="flora-admin-stats__custom-period" data-custom-period>
      <label>
        Від
        <input type="date" name="from" />
      </label>
      <label>
        До
        <input type="date" name="to" />
      </label>
      <button type="submit">Показати період</button>
    </form>

    <div class="flora-admin-stats__period" data-period-label>
      Обраний період: 30 днів. Порівняння з попереднім сопоставимим періодом.
    </div>

    <div class="flora-admin-stats__grid" data-kpi-grid></div>

    <section class="flora-admin-stats__panel">
      <div class="flora-admin-stats__panel-head">
        <div>
          <h2>Динаміка по днях</h2>
          <p>Серії можна вмикати й вимикати.</p>
        </div>
        <div class="flora-admin-stats__series">
          <label><input type="checkbox" data-series="sessions" checked /> Сесії</label>
          <label><input type="checkbox" data-series="page_views" checked /> Перегляди</label>
          <label><input type="checkbox" data-series="product_views" checked /> Рослини</label>
          <label><input type="checkbox" data-series="add_to_cart" checked /> Кошик</label>
          <label><input type="checkbox" data-series="copied_requests" checked /> Заявки</label>
        </div>
      </div>
      <div class="flora-admin-stats__bars" data-daily-series></div>
    </section>

    <section class="flora-admin-stats__panel">
      <h2>Таблиця по днях</h2>
      <div class="flora-admin-stats__table-wrap">
        <table class="flora-admin-stats__table" data-daily-table></table>
      </div>
    </section>

    <section class="flora-admin-stats__panel">
      <h2>Поведінкова воронка</h2>
      <div class="flora-admin-stats__funnel" data-funnel></div>
    </section>

    <section class="flora-admin-stats__columns">
      <div class="flora-admin-stats__panel">
        <h2>Популярні рослини</h2>
        <div class="flora-admin-stats__table-wrap">
          <table class="flora-admin-stats__table" data-top-products></table>
        </div>
      </div>

      <div class="flora-admin-stats__panel">
        <h2>Популярні сторінки</h2>
        <div class="flora-admin-stats__table-wrap">
          <table class="flora-admin-stats__table" data-popular-pages></table>
        </div>
      </div>
    </section>

    <section class="flora-admin-stats__columns">
      <div class="flora-admin-stats__panel">
        <h2>Джерела трафіку</h2>
        <div class="flora-admin-stats__table-wrap">
          <table class="flora-admin-stats__table" data-traffic-sources></table>
        </div>
      </div>

      <div class="flora-admin-stats__panel">
        <h2>Якість каналів</h2>
        <div class="flora-admin-stats__table-wrap">
          <table class="flora-admin-stats__table" data-source-quality></table>
        </div>
      </div>
    </section>

    <section class="flora-admin-stats__columns">
      <div class="flora-admin-stats__panel">
        <h2>Пристрої</h2>
        <div class="flora-admin-stats__table-wrap">
          <table class="flora-admin-stats__table" data-device-classes></table>
        </div>
      </div>

      <div class="flora-admin-stats__panel">
        <h2>Події</h2>
        <div class="flora-admin-stats__table-wrap">
          <table class="flora-admin-stats__table" data-event-table></table>
        </div>
      </div>
    </section>

    <section class="flora-admin-stats__panel flora-admin-stats__deferred">
      <h2>Продажі</h2>
      <p data-commercial-state>Confirmed order analytics not connected.</p>
      <p>Цей блок не показує фейкові замовлення, виручку або середній чек до підключення підтвердженого Orders-source.</p>
    </section>

    <section class="flora-admin-stats__panel flora-admin-stats__deferred">
      <h2>Географія та пошук</h2>
      <p data-geo-state>Географія не підключена: IP не зберігаються.</p>
      <p data-search-state>Пошукові запити не показуються до окремого privacy design.</p>
    </section>

    <p class="flora-admin-stats__access">
      Доступ до цієї сторінки та <code>/api/analytics/summary</code> має бути закритий Cloudflare Access.
      Public endpoint збору подій: <code>/api/analytics/event</code>.
      <span data-last-updated></span>
    </p>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector("[data-admin-statistics]");
  const notice = document.querySelector("[data-analytics-notice]");
  const numberFormat = new Intl.NumberFormat("uk-UA");
  const percentFormat = new Intl.NumberFormat("uk-UA", { maximumFractionDigits: 2 });
  let latestData = null;

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function setNotice(message, type = "info") {
    if (!(notice instanceof HTMLElement)) return;
    notice.textContent = message;
    notice.dataset.type = type;
    notice.hidden = !message;
  }

  function formatValue(value, format = "number") {
    const number = Number(value || 0);
    if (format === "percent") return `${percentFormat.format(number)}%`;
    return numberFormat.format(Math.round(number));
  }

  function formatDelta(row) {
    const absolute = Number(row.delta_absolute || 0);
    const percent = row.delta_percent;
    const sign = absolute > 0 ? "+" : "";
    const percentText = percent === null || percent === undefined ? "без %" : `${percent > 0 ? "+" : ""}${percentFormat.format(percent)}%`;
    return `${sign}${formatValue(absolute, row.format)} · ${percentText}`;
  }

  function renderKpis(rows = []) {
    const grid = document.querySelector("[data-kpi-grid]");
    if (!(grid instanceof HTMLElement)) return;
    grid.innerHTML = rows
      .map(
        (row) => `
          <article>
            <span>${escapeHtml(row.label)}</span>
            <strong>${formatValue(row.current, row.format)}</strong>
            <small>Було: ${formatValue(row.previous, row.format)}<br />${formatDelta(row)}</small>
          </article>
        `
      )
      .join("");
  }

  function activeSeries() {
    return Array.from(document.querySelectorAll("[data-series]:checked")).map((item) => item.dataset.series);
  }

  function renderDailyChart(rows = []) {
    const container = document.querySelector("[data-daily-series]");
    if (!(container instanceof HTMLElement)) return;
    const series = activeSeries();
    const visibleRows = rows.slice(-45);
    const max = Math.max(
      ...visibleRows.flatMap((row) => series.map((name) => Number(row[name] || 0))),
      1
    );

    if (visibleRows.length === 0) {
      container.innerHTML = "<p>Даних за період ще немає.</p>";
      return;
    }

    container.innerHTML = visibleRows
      .map((row) => {
        const bars = series
          .map((name) => {
            const value = Number(row[name] || 0);
            const height = Math.max(value ? 6 : 0, Math.round((value / max) * 100));
            return `<span class="flora-admin-stats__bar flora-admin-stats__bar--${name}" title="${escapeHtml(row.day)} ${name}: ${value}" style="height:${height}%"><em>${value || ""}</em></span>`;
          })
          .join("");
        return `<div class="flora-admin-stats__bar-group">${bars}<small>${escapeHtml(String(row.day).slice(5))}</small></div>`;
      })
      .join("");
  }

  function table(selector, headers, rows, mapRow) {
    const element = document.querySelector(selector);
    if (!(element instanceof HTMLElement)) return;
    if (!rows || rows.length === 0) {
      element.innerHTML = `<tbody><tr><td>Даних за період ще немає.</td></tr></tbody>`;
      return;
    }
    element.innerHTML = `
      <thead><tr>${headers.map((header) => `<th>${escapeHtml(header)}</th>`).join("")}</tr></thead>
      <tbody>${rows.map((row) => `<tr>${mapRow(row).map((cell) => `<td>${cell}</td>`).join("")}</tr>`).join("")}</tbody>
    `;
  }

  function renderDailyTable(rows = []) {
    table(
      "[data-daily-table]",
      ["Дата", "Перегляди", "Сесії", "Відвідувачі", "Рослини", "Кошик", "Заявки", "Конверсія"],
      rows,
      (row) => [
        escapeHtml(row.day),
        formatValue(row.page_views),
        formatValue(row.sessions),
        formatValue(row.visitors),
        formatValue(row.product_views),
        formatValue(row.add_to_cart),
        formatValue(row.copied_requests),
        formatValue(row.conversion, "percent")
      ]
    );
  }

  function renderFunnel(rows = []) {
    const element = document.querySelector("[data-funnel]");
    if (!(element instanceof HTMLElement)) return;
    element.innerHTML = rows
      .map(
        (row) => `
          <article>
            <span>${escapeHtml(row.step)}</span>
            <strong>${formatValue(row.unique_sessions)} сес.</strong>
            <small>${formatValue(row.event_count)} подій · ${formatValue(row.conversion_from_previous, "percent")} від попереднього · drop-off ${formatValue(row.drop_off, "percent")}</small>
          </article>
        `
      )
      .join("");
  }

  function renderTables(data) {
    table(
      "[data-top-products]",
      ["Рослина", "Plant ID", "Перегляди", "Сесії", "Кошик", "Заявки", "View→Cart", "Cart→Copy"],
      data.top_products || [],
      (row) => [
        escapeHtml(row.plant_name || row.plant_id),
        escapeHtml(row.plant_id),
        formatValue(row.views),
        formatValue(row.unique_sessions),
        formatValue(row.add_to_cart),
        formatValue(row.copied_requests),
        formatValue(row.view_to_cart_conversion, "percent"),
        formatValue(row.cart_to_copy_conversion, "percent")
      ]
    );

    table(
      "[data-popular-pages]",
      ["Сторінка", "Тип", "Перегляди", "Сесії", "Частка"],
      data.popular_pages || [],
      (row) => [
        escapeHtml(row.pathname),
        escapeHtml(row.page_type),
        formatValue(row.views),
        formatValue(row.unique_sessions),
        formatValue(row.share_of_views, "percent")
      ]
    );

    table(
      "[data-traffic-sources]",
      ["Канал", "Джерело", "Сесії", "Частка", "Перегляди"],
      data.traffic_sources || [],
      (row) => [
        escapeHtml(row.channel),
        escapeHtml(row.source),
        formatValue(row.sessions),
        formatValue(row.share, "percent"),
        formatValue(row.page_views)
      ]
    );

    table(
      "[data-source-quality]",
      ["Канал", "Сесії", "Рослини", "Кошик", "Заявки", "Session→Cart", "Session→Copy"],
      data.source_quality || [],
      (row) => [
        escapeHtml(`${row.channel}: ${row.source}`),
        formatValue(row.sessions),
        formatValue(row.plant_views),
        formatValue(row.add_to_cart),
        formatValue(row.copied_requests),
        formatValue(row.session_to_cart_conversion, "percent"),
        formatValue(row.session_to_copy_conversion, "percent")
      ]
    );

    table(
      "[data-device-classes]",
      ["Пристрій", "Сесії", "Частка", "Рослини", "Кошик", "Заявки", "Copy conv."],
      data.device_classes || [],
      (row) => [
        escapeHtml(row.device_class),
        formatValue(row.sessions),
        formatValue(row.share, "percent"),
        formatValue(row.plant_views),
        formatValue(row.add_to_cart),
        formatValue(row.copied_requests),
        formatValue(row.copy_request_conversion, "percent")
      ]
    );

    table(
      "[data-event-table]",
      ["Подія", "Кількість", "Сесії", "Частка", "Остання"],
      data.event_table || [],
      (row) => [
        escapeHtml(row.event_name),
        formatValue(row.event_count),
        formatValue(row.unique_sessions),
        formatValue(row.share, "percent"),
        escapeHtml(row.last_seen)
      ]
    );
  }

  function renderStatusBlocks(data) {
    const commercial = document.querySelector("[data-commercial-state]");
    const geo = document.querySelector("[data-geo-state]");
    const search = document.querySelector("[data-search-state]");
    const lastUpdated = document.querySelector("[data-last-updated]");
    const periodLabel = document.querySelector("[data-period-label]");

    if (commercial) commercial.textContent = data.commercial?.message || "Confirmed order analytics not connected.";
    if (geo) geo.textContent = data.geography?.reason || "Географія не підключена.";
    if (search) search.textContent = data.search_analytics?.reason || "Пошук відкладено.";
    if (lastUpdated) lastUpdated.textContent = data.meta?.generated_at ? ` Оновлено: ${data.meta.generated_at}. SQL-запитів: ${data.meta.query_count || 0}.` : "";
    if (periodLabel) {
      periodLabel.textContent = `Обраний період: ${data.range?.label || data.range?.preset || ""}. Попередній період: ${data.range?.previous?.label || "немає даних"}.`;
    }
  }

  function render(data) {
    latestData = data;
    renderKpis(data.kpis || []);
    renderDailyChart(data.daily_table || []);
    renderDailyTable(data.daily_table || []);
    renderFunnel(data.funnel || []);
    renderTables(data);
    renderStatusBlocks(data);
  }

  async function load(query = "preset=30d") {
    if (!(root instanceof HTMLElement)) return;
    root.classList.add("is-loading");
    setNotice("Завантажуємо статистику...", "info");

    try {
      const response = await fetch(`/api/analytics/summary?${query}`, {
        credentials: "same-origin"
      });
      const data = await response.json().catch(() => ({}));

      if (!response.ok || data.configured === false) {
        render(data);
        setNotice(data.message || "Аналітику ще не підключено до Cloudflare. Дані не збираються.", "warning");
        return;
      }

      render(data);
      setNotice("", "info");
    } catch {
      setNotice("Не вдалося отримати статистику. Перевірте Cloudflare Access та Analytics Engine.", "warning");
    } finally {
      root.classList.remove("is-loading");
    }
  }

  document.querySelectorAll("[data-period]").forEach((button) => {
    button.addEventListener("click", () => {
      document.querySelectorAll("[data-period]").forEach((item) => item.classList.remove("is-active"));
      button.classList.add("is-active");
      load(`preset=${encodeURIComponent(button.dataset.period || "30d")}`);
    });
  });

  document.querySelector("[data-custom-period]")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    const from = String(data.get("from") || "");
    const to = String(data.get("to") || "");
    document.querySelectorAll("[data-period]").forEach((item) => item.classList.remove("is-active"));
    load(`from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`);
  });

  document.querySelectorAll("[data-series]").forEach((checkbox) => {
    checkbox.addEventListener("change", () => {
      if (latestData) renderDailyChart(latestData.daily_table || []);
    });
  });

  load("preset=30d");
</script>
