---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCategories, getProducts, getPublicAvailabilityLabel } from "../lib/products";

const products = getProducts();
const categories = getCategories();
---

<BaseLayout title="Каталог рослин | Flora & Aroma">
  <section class="page-title">
    <p class="eyebrow">Актуальний асортимент</p>
    <h1>Каталог рослин</h1>
    <p>Оберіть рослини за категоріями або відкрийте картку для фото, опису, формату і ціни. Наявність підтверджує оператор.</p>
  </section>

  <section class="section compact-section" aria-label="Категорії">
    <div class="category-strip">
      {categories.map((category) => (
        <a href={`/categories/${category.slug}/`}>
          {category.name}
          <span>{category.count}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section compact-section" aria-label="Каталог рослин">
    <div class="section-heading">
      <h2>Усі рослини</h2>
      <p><a href="/price/">Відкрити табличний прайс</a></p>
    </div>
    <div class="product-grid catalog-grid">
      {products.map((product) => (
        <a class="product-card" href={`/plants/${product.slug}/`}>
          {product.primary_image_path && <img src={product.primary_image_path} alt="" loading="lazy" />}
          <span class="plant-id">{product.category}</span>
          <h3>{product.name_uk}</h3>
          <p><em>{product.latin_name}</em></p>
          <p class="summary">{product.summary}</p>
          <dl>
            <div>
              <dt>Формат</dt>
              <dd>{product.container}</dd>
            </div>
            <div>
              <dt>Ціна</dt>
              <dd>{product.price_uah} UAH/{product.unit}</dd>
            </div>
            <div>
              <dt>Наявність</dt>
              <dd>{getPublicAvailabilityLabel(product)}</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
