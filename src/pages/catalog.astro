---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatFlowering, formatHeight, getCategories, getProducts, getPublicAvailabilityLabel } from "../lib/products";

const products = getProducts();
const categories = getCategories();
const containers = Array.from(new Set(products.flatMap((product) => product.options.map((option) => option.container)))).sort((a, b) => a.localeCompare(b, "uk"));
const maxPrice = Math.max(...products.flatMap((product) => product.options.map((option) => option.price_uah)));

function optionContainers(product) {
  return product.options.map((option) => option.container).join("; ");
}

function optionPriceLabel(product) {
  if (product.options.length === 1) {
    const option = product.options[0];
    return `${option.price_uah} UAH/${option.unit}`;
  }

  return product.options.map((option) => option.label).join("; ");
}

function minOptionPrice(product) {
  return Math.min(...product.options.map((option) => option.price_uah));
}
---

<BaseLayout title="Каталог рослин | Flora & Aroma">
  <section class="page-title">
    <p class="eyebrow">Актуальний асортимент</p>
    <h1>Каталог рослин</h1>
    <p>Оберіть рослини за категоріями або відкрийте картку для фото, опису, формату і ціни. Наявність підтверджує оператор.</p>
  </section>

  <section class="section compact-section" aria-label="Категорії">
    <div class="category-strip">
      {categories.map((category) => (
        <a href={`/categories/${category.slug}/`}>
          {category.name}
          <span>{category.count}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section compact-section" aria-label="Підбір рослин">
    <form class="filter-panel" data-catalog-filters>
      <label>
        Категорія
        <select name="category">
          <option value="">Усі категорії</option>
          {categories.map((category) => <option value={category.slug}>{category.name}</option>)}
        </select>
      </label>
      <label>
        Освітлення
        <select name="sun">
          <option value="">Будь-яке</option>
          <option value="full_sun">Сонце</option>
          <option value="part_sun">Півтінь</option>
        </select>
      </label>
      <label>
        Волога
        <select name="moisture">
          <option value="">Будь-яка</option>
          <option value="dry">Сухі місця</option>
          <option value="medium">Помірна</option>
          <option value="moist">Вологі місця</option>
        </select>
      </label>
      <label>
        Цвітіння
        <select name="flowering">
          <option value="">Будь-коли</option>
          <option value="05">Травень</option>
          <option value="06">Червень</option>
          <option value="07">Липень</option>
          <option value="08">Серпень</option>
          <option value="09">Вересень</option>
        </select>
      </label>
      <label>
        Призначення
        <select name="use">
          <option value="">Будь-яке</option>
          <option value="aromatic">Ароматичні</option>
          <option value="pollinator">Для запилювачів</option>
          <option value="border">Бордюри</option>
          <option value="groundcover">Ґрунтопокривні</option>
          <option value="culinary">Пряні</option>
          <option value="medicinal">Лікарські</option>
        </select>
      </label>
      <label>
        Формат
        <select name="container">
          <option value="">Усі формати</option>
          {containers.map((container) => <option value={container}>{container}</option>)}
        </select>
      </label>
      <label>
        Ціна до
        <input type="number" name="price" min="0" max={maxPrice} step="5" placeholder={`${maxPrice} UAH`} />
      </label>
      <button class="button button-secondary" type="reset">Скинути</button>
    </form>
    <p class="filter-count" data-filter-count>{products.length} позицій</p>
  </section>

  <section class="section compact-section" aria-label="Каталог рослин">
    <div class="section-heading">
      <h2>Усі рослини</h2>
      <p><a href="/price/">Відкрити табличний прайс</a></p>
    </div>
    <div class="product-grid catalog-grid">
      {products.map((product) => (
        <article
          class="product-card"
          data-product-card
          data-category={product.category_slug}
          data-sun={product.sun_exposure}
          data-moisture={product.moisture}
          data-flowering={product.flowering_months}
          data-use={product.use_cases}
          data-container={optionContainers(product)}
          data-price={minOptionPrice(product)}
        >
          <a class="product-card-link" href={`/plants/${product.slug}/`}>
            {product.primary_image_path && <img src={product.primary_image_path} alt="" loading="lazy" />}
          </a>
          <span class="plant-id">{product.category}</span>
          <h3><a href={`/plants/${product.slug}/`}>{product.name_uk}</a></h3>
          <p><em>{product.latin_name}</em></p>
          <p class="summary">{product.summary}</p>
          <div class="card-chips" aria-label="Короткі характеристики">
            <span>сонце: {product.sun_labels.join(" / ")}</span>
            <span>вологість: {product.moisture_labels.join(" / ")}</span>
            <span>висота: {formatHeight(product)}</span>
            <span>цвітіння: {formatFlowering(product)}</span>
            <span>призначення: {product.use_case_labels.slice(0, 2).join(", ")}</span>
            <span>формат: {optionContainers(product)}</span>
            <span>ціна: {optionPriceLabel(product)}</span>
          </div>
          <dl>
            <div>
              <dt>Формат</dt>
              <dd>{optionContainers(product)}</dd>
            </div>
            <div>
              <dt>Ціна</dt>
              <dd>{optionPriceLabel(product)}</dd>
            </div>
            <div>
              <dt>Наявність</dt>
              <dd>{getPublicAvailabilityLabel(product)}</dd>
            </div>
          </dl>
          <button
            class="button cart-add-button"
            type="button"
            data-cart-add
            data-plant-id={product.plant_id}
            data-name={product.name_uk}
            data-latin={product.latin_name}
            data-container={product.container}
            data-price={product.price_uah}
            data-unit={product.unit}
            data-option-id={product.options[0].variant_id}
            data-url={`/plants/${product.slug}/`}
            data-image={product.primary_image_path}
          >
            Додати в кошик
          </button>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-catalog-filters]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-card]"));
  const counter = document.querySelector<HTMLElement>("[data-filter-count]");

  function hasToken(value: string | undefined, token: string): boolean {
    if (!token) return true;
    return (value || "").split(/[;|]/).includes(token);
  }

  function applyFilters() {
    if (!form) return;
    const data = new FormData(form);
    const category = String(data.get("category") || "");
    const sun = String(data.get("sun") || "");
    const moisture = String(data.get("moisture") || "");
    const flowering = String(data.get("flowering") || "");
    const use = String(data.get("use") || "");
    const container = String(data.get("container") || "");
    const price = Number(data.get("price") || 0);
    let visible = 0;

    cards.forEach((card) => {
      const matches =
        (!category || card.dataset.category === category) &&
        hasToken(card.dataset.sun, sun) &&
        hasToken(card.dataset.moisture, moisture) &&
        hasToken(card.dataset.flowering, flowering) &&
        hasToken(card.dataset.use, use) &&
        hasToken(card.dataset.container, container) &&
        (!price || Number(card.dataset.price || 0) <= price);

      card.hidden = !matches;
      if (matches) visible += 1;
    });

    if (counter) {
      counter.textContent = `${visible} позицій`;
    }
  }

  form?.addEventListener("input", applyFilters);
  form?.addEventListener("reset", () => window.setTimeout(applyFilters, 0));
</script>
