---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProducts } from "../lib/products";

const products = getProducts();
const priceRows = products.flatMap((product) =>
  product.options.map((option) => ({
    product,
    option
  }))
);
const generatedAt = new Intl.DateTimeFormat("uk-UA", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric"
}).format(new Date());
---

<BaseLayout
  title="Прайс Flora & Aroma"
  description="Актуальний публічний прайс Flora & Aroma: українська назва, латинська назва, формат і ціна рослин."
>
  <section class="page-title">
    <p class="eyebrow">Прайс</p>
    <h1>Актуальний асортимент</h1>
    <p>
      Дата формування: {generatedAt}. Ціни синхронізовані з затвердженим публічним прайсом.
      Наявність і можливість резерву підтверджує оператор у день відповіді.
    </p>
  </section>

  <section class="table-wrap" aria-label="Прайс Flora & Aroma">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Українська назва</th>
          <th>Латинська назва</th>
          <th>Горщик / касета</th>
          <th>Ціна</th>
          <th>Кошик</th>
        </tr>
      </thead>
      <tbody>
        {priceRows.map(({ product, option }) => (
          <tr>
            <td>{product.plant_id}</td>
            <td><a href={`/plants/${product.slug}/`}>{product.name_uk}</a></td>
            <td><em>{product.latin_name}</em></td>
            <td>{option.container}</td>
            <td>{option.price_uah} UAH/{option.unit}</td>
            <td>
              <button
                class="table-cart-button"
                type="button"
                data-cart-add
                data-plant-id={product.plant_id}
                data-name={product.name_uk}
                data-latin={product.latin_name}
                data-container={option.container}
                data-price={option.price_uah}
                data-unit={option.unit}
                data-option-id={option.variant_id}
                data-url={`/plants/${product.slug}/`}
                data-image={product.primary_image_path}
              >
                Додати
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>
