---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatFlowering, formatHeight, getCategories, getProducts } from "../../lib/products";

export function getStaticPaths() {
  return getCategories().map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const products = getProducts().filter((product) => product.category_slug === category.slug);
const description = `${category.name}: ${products.length} позицій Flora & Aroma. Ціни синхронізовані з затвердженим прайсом, наявність підтверджує оператор.`;
---

<BaseLayout title={`${category.name} | Flora & Aroma`} description={description}>
  <section class="page-title">
    <p class="eyebrow">Категорія</p>
    <h1>{category.name}</h1>
    <p>{products.length} позицій. Точну наявність, готовність і резерв підтверджує оператор.</p>
  </section>

  <section class="section">
    <div class="product-grid">
      {products.map((product) => (
        <a class="product-card" href={`/plants/${product.slug}/`}>
          {product.primary_image_path && <img src={product.primary_image_path} alt="" loading="lazy" />}
          <span class="plant-id">{product.category}</span>
          <h3>{product.name_uk}</h3>
          <p>{product.latin_name}</p>
          <p class="summary">{product.summary}</p>
          <div class="card-chips" aria-label="Короткі характеристики">
            <span>сонце: {product.sun_labels.join(" / ")}</span>
            <span>вологість: {product.moisture_labels.join(" / ")}</span>
            <span>висота: {formatHeight(product)}</span>
            <span>цвітіння: {formatFlowering(product)}</span>
            <span>призначення: {product.use_case_labels.slice(0, 2).join(", ")}</span>
            <span>формат: {product.container}</span>
            <span>ціна: {product.price_uah} UAH/{product.unit}</span>
          </div>
          <dl>
            <div>
              <dt>Формат</dt>
              <dd>{product.container}</dd>
            </div>
            <div>
              <dt>Ціна</dt>
              <dd>{product.price_uah} UAH/{product.unit}</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
