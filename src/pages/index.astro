---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatFlowering, formatHeight, getCategories, getProducts, getSelections } from "../lib/products";

const products = getProducts();
const featuredPlantIds = ["PLANT-0041", "PLANT-0082", "PLANT-0014", "PLANT-0048"];
const featured = featuredPlantIds
  .map((plantId) => products.find((product) => product.plant_id === plantId))
  .filter((product) => product !== undefined);
const categories = getCategories();
const selections = getSelections();
const solutionLinks = [
  {
    title: "Ароматна грядка",
    href: "/selections/aromatic-garden/",
    text: "Шавлії, м'яти, чабер, майоран та інші ароматні культури для доріжок, кухонної грядки і камерного саду."
  },
  {
    title: "Сухий квітник",
    href: "/selections/drought-tolerant/",
    text: "Рослини для сонячних місць із добрим дренажем, де потрібна витривалість і проста підтримка."
  },
  {
    title: "Медоносна посадка",
    href: "/selections/pollinator-plants/",
    text: "Квітучі позиції для бджіл, джмелів і метеликів, які додають руху та сезонного цвітіння."
  },
  {
    title: "Бордюр",
    href: "/selections/border-plants/",
    text: "Компактні й середньорослі культури для краю квітника, доріжок і структурних ліній."
  }
];
---

<BaseLayout title="Flora & Aroma | Саджанці у касетах і горщиках">
  <section class="hero hero-nursery">
    <div>
      <p class="eyebrow">Дім правильних рослин</p>
      <h1>FLORA & AROMA</h1>
      <p>
        Ми вирощуємо саджанці для саду, квітників, ароматичних посадок і ландшафтних рішень.
        У каталозі показані рослини в касетах Hiko та горщиках з публічною ціною; наявність,
        кількість і можливість резерву підтверджує оператор у день відповіді.
      </p>
      <div class="hero-proof-list" aria-label="Коротко про асортимент">
        <span>власне вирощування</span>
        <span>касети / горщики</span>
        <span>закрита коренева система</span>
        <span>заявка без автоматичного резерву</span>
      </div>
      <div class="hero-actions">
        <a class="button" href="/catalog/">Дивитися каталог</a>
        <a class="button button-secondary" href="/cart/">Скласти заявку</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="trust-strip" aria-label="Переваги Flora & Aroma">
      <div>
        <strong>Вирощуємо самі</strong>
        <span>Контролюємо партії, формат рослин і якість саджанців до передачі клієнту.</span>
      </div>
      <div>
        <strong>Касети Hiko / горщики</strong>
        <span>Публікуємо формат постачання біля кожної позиції, щоб замовлення було зрозумілим.</span>
      </div>
      <div>
        <strong>Закрита коренева система</strong>
        <span>Саджанці зручні для перевезення, дорощування та висадки без оголеного кореня.</span>
      </div>
    </div>
  </section>

  <section class="section media-band">
    <img src="/images/site/nursery-irrigation.jpg" alt="Виробництво саджанців Flora & Aroma" loading="lazy" />
    <div>
      <p class="eyebrow">Фото виробництва</p>
      <h2>Рослини проходять шлях від касети до готової посадки</h2>
      <p>
        Вітрина показує асортимент для клієнта, але не відкриває внутрішній склад.
        Перед підтвердженням заявки оператор перевіряє актуальну наявність, формат і кількість.
      </p>
      <a class="button button-secondary" href="/how-to-order/">Як працює заявка</a>
    </div>
  </section>

  <section class="section compact-section">
    <div class="section-heading">
      <h2>Підібрати рослини</h2>
      <p>Швидкі клієнтські підбірки за умовами ділянки та призначенням.</p>
    </div>
    <div class="link-grid selection-grid">
      {selections.map((selection) => (
        <a href={`/selections/${selection.slug}/`}>
          <span>{selection.title}</span>
          <p>{selection.description} {selection.count} позицій.</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section compact-section">
    <div class="section-heading">
      <h2>Готові рішення</h2>
      <p>Стартові сценарії для клієнта: не готовий проект, а зручний напрямок для підбору.</p>
    </div>
    <div class="link-grid solution-grid">
      {solutionLinks.map((solution) => (
        <a href={solution.href}>
          <span>{solution.title}</span>
          <p>{solution.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Основні розділи</h2>
      <p>Короткий шлях від перегляду асортименту до чернетки заявки оператору.</p>
    </div>
    <div class="link-grid">
      <a href="/catalog/">
        <span>Каталог</span>
        <p>Усі рослини з фото, описами, форматом, ціною та фільтрами підбору.</p>
      </a>
      <a href="/price/">
        <span>Прайс</span>
        <p>Таблиця для швидкого перегляду цін і форматів постачання.</p>
      </a>
      <a href="/cart/">
        <span>Кошик-заявка</span>
        <p>Чернетка звернення: кількість і резерв підтверджує оператор.</p>
      </a>
      <a href="/contacts/">
        <span>Контакти</span>
        <p>Телефон і короткий шлях для уточнення асортименту.</p>
      </a>
    </div>
  </section>

  <section class="section media-band media-band-reverse">
    <img src="/images/site/nursery-greenhouse.jpg" alt="Касетне вирощування рослин у питомнику" loading="lazy" />
    <div>
      <p class="eyebrow">Комерційна витрина</p>
      <h2>Ціна відкрита, точний склад не публікується</h2>
      <p>
        На сайті є публічний асортимент і ціна за одиницю. Це допомагає швидко зібрати заявку,
        але не створює автоматичний заказ, резерв, оплату або списання складу.
      </p>
      <a class="button" href="/catalog/">Перейти до асортименту</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Найчастіше обирають</h2>
      <p>Добірка з актуального публічного асортименту. Наявність підтверджує оператор.</p>
    </div>
    <div class="category-strip" aria-label="Категорії рослин">
      {categories.map((category) => (
        <a href={`/categories/${category.slug}/`}>
          {category.name}
          <span>{category.count}</span>
        </a>
      ))}
    </div>
    <div class="product-grid">
      {featured.map((product) => (
        <a class="product-card" href={`/plants/${product.slug}/`}>
          {product.primary_image_path && <img src={product.primary_image_path} alt="" loading="lazy" />}
          <span class="plant-id">{product.category}</span>
          <h3>{product.name_uk}</h3>
          <p>{product.latin_name}</p>
          <p class="summary">{product.summary}</p>
          <div class="card-chips" aria-label="Короткі характеристики">
            <span>сонце: {product.sun_labels.join(" / ")}</span>
            <span>вологість: {product.moisture_labels.join(" / ")}</span>
            <span>висота: {formatHeight(product)}</span>
            <span>цвітіння: {formatFlowering(product)}</span>
            <span>формат: {product.container}</span>
            <span>ціна: {product.price_uah} UAH/{product.unit}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
