---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCategories, getProducts } from "../lib/products";

const products = getProducts();
const featured = products.slice(0, 8);
const categories = getCategories();
---

<BaseLayout title="Flora & Aroma | Актуальний асортимент рослин">
  <section class="hero hero-nursery">
    <div>
      <p class="eyebrow">Дім правильних рослин</p>
      <h1>FLORA & AROMA</h1>
      <p>
        Саджанці, вирощені за сучасними технологіями.
        Для саду, квітників, ароматичних посадок і ландшафтних рішень.
      </p>
      <div class="hero-actions">
        <a class="button" href="/catalog/">Дивитися каталог</a>
        <a class="button button-secondary" href="/how-to-order/">Як замовити</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="trust-strip" aria-label="Переваги Flora & Aroma">
      <div>
        <strong>Касети і горщики</strong>
        <span>зручний формат для посадки та дорощування</span>
      </div>
      <div>
        <strong>40 позицій</strong>
        <span>у поточному публічному асортименті</span>
      </div>
      <div>
        <strong>Оператор підтверджує</strong>
        <span>наявність, резерв і спосіб отримання</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Основні розділи</h2>
      <p>Короткий шлях від перегляду асортименту до заявки оператору.</p>
    </div>
    <div class="link-grid">
      <a href="/catalog/">
        <span>Каталог</span>
        <p>Усі рослини з фото, описами, форматом і ціною.</p>
      </a>
      <a href="/price/">
        <span>Прайс</span>
        <p>Таблиця для швидкого перегляду цін і форматів постачання.</p>
      </a>
      <a href="/how-to-order/">
        <span>Як замовити</span>
        <p>Порядок уточнення наявності, резерву, оплати й отримання.</p>
      </a>
      <a href="/contacts/">
        <span>Контакти</span>
        <p>Телефон і коротка форма повідомлення для заявки.</p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Найчастіше обирають</h2>
      <p>Добірка з актуального публічного асортименту. Наявність підтверджує оператор.</p>
    </div>
    <div class="category-strip" aria-label="Категорії рослин">
      {categories.map((category) => (
        <a href={`/categories/${category.slug}/`}>
          {category.name}
          <span>{category.count}</span>
        </a>
      ))}
    </div>
    <div class="product-grid">
      {featured.map((product) => (
        <a class="product-card" href={`/plants/${product.slug}/`}>
          {product.primary_image_path && <img src={product.primary_image_path} alt="" loading="lazy" />}
          <span class="plant-id">{product.category}</span>
          <h3>{product.name_uk}</h3>
          <p>{product.latin_name}</p>
          <p class="summary">{product.summary}</p>
          <dl>
            <div>
              <dt>Формат</dt>
              <dd>{product.container}</dd>
            </div>
            <div>
              <dt>Ціна</dt>
              <dd>{product.price_uah} UAH/{product.unit}</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
